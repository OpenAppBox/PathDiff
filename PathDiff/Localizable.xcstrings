    "Files that differ only in CRLF vs. LF count as equal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعدّ الملفات التي لا تختلف إلا في CRLF مقابل LF متطابقة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer, der kun adskiller sig ved CRLF og LF, regnes som ens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien, die sich nur durch CRLF und LF unterscheiden, gelten als gleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos que solo se diferencian en CRLF o LF se consideran iguales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostot, jotka eroavat vain CRLF- ja LF-rivinvaihtojen osalta, katsotaan samoiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers qui ne diffèrent que par CRLF ou LF sont considérés comme identiques."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो फ़ाइलें केवल CRLF बनाम LF में भिन्न हैं, उन्हें समान माना जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang hanya berbeda dalam CRLF vs. LF dianggap sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file che differiscono solo per CRLF o LF sono considerati uguali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改行コード（CRLFとLF）だけが異なるファイルは同一とみなされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CRLF와 LF만 다른 파일은 같은 것으로 간주합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som bare er forskjellige i CRLF og LF, regnes som like."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden die alleen verschillen in CRLF of LF, gelden als gelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki różniące się tylko znakami CRLF i LF są uznawane za takie same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos que diferem apenas em CRLF vs. LF são considerados iguais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы, которые различаются только окончаниями строк (CRLF или LF), считаются одинаковыми."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som bara skiljer sig åt i CRLF eller LF räknas som lika."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ที่ต่างกันเพียง CRLF กับ LF จะถือว่าเหมือนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca CRLF / LF farkı olan dosyalar aynı sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp chỉ khác nhau ở CRLF và LF được coi là giống nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅换行符（CRLF 与 LF）不同的文件视为相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 CRLF 與 LF 差異的檔案視為相同。"
          }
        }
      }
    },
    "Files that macOS and Windows leave on drives, such as ._ files, .Spotlight-V100 and Thumbs.db, are ignored by default." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم افتراضيًا تجاهل الملفات التي يتركها macOS وWindows على الأقراص، مثل ملفات ._ و .Spotlight-V100 و Thumbs.db."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer, som macOS og Windows efterlader på drev, f.eks. ._-filer, .Spotlight-V100 og Thumbs.db, ignoreres som standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien, die macOS und Windows auf Laufwerken hinterlassen, etwa ._-Dateien, .Spotlight-V100 und Thumbs.db, werden standardmäßig ignoriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos que macOS y Windows dejan en los discos, como los archivos ._, .Spotlight-V100 y Thumbs.db, se ignoran por omisión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostot, joita macOS ja Windows jättävät asemille, kuten ._-tiedostot, .Spotlight-V100 ja Thumbs.db, ohitetaan oletuksena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers que macOS et Windows laissent sur les disques, comme les fichiers ._, .Spotlight-V100 et Thumbs.db, sont ignorés par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS और Windows द्वारा ड्राइव पर छोड़ी गई फ़ाइलें, जैसे ._ फ़ाइलें, .Spotlight-V100 और Thumbs.db, डिफ़ॉल्ट रूप से अनदेखी की जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang ditinggalkan macOS dan Windows di drive, seperti file ._, .Spotlight-V100, dan Thumbs.db, diabaikan secara default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file che macOS e Windows lasciano sui dischi, come i file ._, .Spotlight-V100 e Thumbs.db, vengono ignorati per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "._ファイル、.Spotlight-V100、Thumbs.dbなど、macOSやWindowsがドライブに残すファイルはデフォルトで無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "._ 파일, .Spotlight-V100, Thumbs.db 등 macOS와 Windows가 드라이브에 남기는 파일은 기본적으로 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som macOS og Windows legger igjen på disker, for eksempel ._-filer, .Spotlight-V100 og Thumbs.db, ignoreres som standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden die macOS en Windows op schijven achterlaten, zoals ._-bestanden, .Spotlight-V100 en Thumbs.db, worden standaard genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki pozostawiane na dyskach przez macOS i Windows, takie jak pliki ._, .Spotlight-V100 i Thumbs.db, są domyślnie ignorowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos que o macOS e o Windows deixam nos discos, como arquivos ._, .Spotlight-V100 e Thumbs.db, são ignorados por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы, которые macOS и Windows оставляют на дисках, например файлы ._, .Spotlight-V100 и Thumbs.db, по умолчанию игнорируются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som macOS och Windows lämnar kvar på enheter, till exempel ._-filer, .Spotlight-V100 och Thumbs.db, ignoreras som standard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ที่ macOS และ Windows ทิ้งไว้บนไดรฟ์ เช่น ไฟล์ ._ .Spotlight-V100 และ Thumbs.db จะถูกละเว้นตามค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
