    "“%@” can no longer be opened. The folders may have been moved, renamed or deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد بالإمكان فتح «%@». ربما تم نقل المجلدات أو إعادة تسميتها أو حذفها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« kan ikke længere åbnes. Mapperne er muligvis blevet flyttet, omdøbt eller slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht mehr geöffnet werden. Die Ordner wurden möglicherweise verschoben, umbenannt oder gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no se puede abrir. Puede que las carpetas se hayan movido, renombrado o eliminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertailua ”%@” ei voi enää avata. Kansiot on ehkä siirretty, nimetty uudelleen tai poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut plus être ouvert. Les dossiers ont peut-être été déplacés, renommés ou supprimés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” को अब खोला नहीं जा सकता। हो सकता है कि फ़ोल्डर स्थानांतरित कर दिए गए हों, उनके नाम बदल दिए गए हों या उन्हें डिलीट कर दिया गया हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tidak dapat dibuka lagi. Folder mungkin telah dipindahkan, diubah namanya, atau dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire «%@». Le cartelle potrebbero essere state spostate, rinominate o eliminate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を開けなくなりました。フォルダが移動、名称変更、または削除された可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 항목을 더 이상 열 수 없습니다. 폴더가 이동, 이름 변경 또는 삭제되었을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» kan ikke lenger åpnes. Mappene kan ha blitt flyttet, omdøpt eller slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan niet meer worden geopend. De mappen zijn mogelijk verplaatst, hernoemd of verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można już otworzyć „%@”. Foldery mogły zostać przeniesione, przemianowane lub usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é mais possível abrir “%@”. As pastas podem ter sido movidas, renomeadas ou apagadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается открыть «%@». Возможно, папки были перемещены, переименованы или удалены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” kan inte längre öppnas. Mapparna kan ha flyttats, bytt namn eller raderats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถเปิด “%@” ได้อีกต่อไป โฟลเดอร์อาจถูกย้าย เปลี่ยนชื่อ หรือลบไปแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” artık açılamıyor. Klasörler taşınmış, yeniden adlandırılmış ya da silinmiş olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể mở “%@” nữa. Các thư mục có thể đã bị di chuyển, đổi tên hoặc xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法再打开“%@”。文件夹可能已被移动、重新命名或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法再打開「%@」。檔案夾可能已被搬移、重新命名或刪除。"
          }
        }
      }
    },
