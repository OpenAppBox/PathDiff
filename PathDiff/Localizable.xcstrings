    "All entries and their backups are deleted. Changes can then no longer be reverted from here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف كل الإدخالات ونسخها الاحتياطية، ولن يعود بالإمكان بعد ذلك إرجاع التغييرات من هنا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle poster og deres sikkerhedskopier slettes. Ændringer kan derefter ikke længere tilbageføres herfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Einträge und ihre Backups werden gelöscht. Änderungen können danach hier nicht mehr zurückgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las entradas y sus copias de seguridad. Después ya no podrás revertir los cambios desde aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki merkinnät ja niiden varmuuskopiot poistetaan. Tämän jälkeen muutoksia ei voi enää palauttaa täältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les entrées et leurs sauvegardes seront supprimées. Les modifications ne pourront alors plus être restaurées d’ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी प्रविष्टियाँ और उनके बैकअप डिलीट कर दिए जाएँगे। इसके बाद परिवर्तनों को यहाँ से वापस नहीं लौटाया जा सकेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua entri beserta cadangannya akan dihapus. Setelah itu, perubahan tidak dapat lagi dikembalikan dari sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le voci e i relativi backup verranno eliminati. Da qui non sarà più possibile ripristinare le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての履歴項目とそのバックアップが削除されます。以降、ここから変更を戻すことはできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기록 항목과 해당 백업이 삭제됩니다. 이후에는 여기에서 변경 사항을 복귀할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle oppføringer og sikkerhetskopiene deres slettes. Endringer kan deretter ikke lenger tilbakestilles herfra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vermeldingen en hun reservekopieën worden verwijderd. Wijzigingen kunnen daarna niet meer vanaf hier worden teruggezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie wpisy i ich kopie zapasowe zostaną usunięte. Zmian nie będzie już można wycofać z tego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as entradas e seus backups serão apagados. Depois disso, não será mais possível reverter as alterações por aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все записи и их резервные копии будут удалены. После этого откатить изменения отсюда будет невозможно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla poster och deras säkerhetskopior raderas. Därefter går det inte längre att återställa ändringar härifrån."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการทั้งหมดและข้อมูลสำรองจะถูกลบ หลังจากนั้นจะไม่สามารถย้อนกลับการเปลี่ยนแปลงจากที่นี่ได้อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm kayıtlar ve yedekleri silinir. Bundan sonra değişiklikler buradan geri döndürülemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả mục nhập và bản sao lưu của chúng sẽ bị xóa. Sau đó, bạn không thể hoàn nguyên các thay đổi từ đây nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有条目及其备份都将被删除。之后将无法再从这里复原更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有記錄及其備份都會被刪除。之後就無法再從這裡回復變更。"
          }
        }
      }
    },
