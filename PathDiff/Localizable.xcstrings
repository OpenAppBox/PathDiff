          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संपादित फ़ाइलें सहेजें (⌘S)। सहेजने को पूर्ववत किया जा सकता है या इतिहास से वापस लौटाया जा सकता है।"
