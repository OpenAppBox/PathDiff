    "Nothing is deleted or overwritten with an older copy. Moved and renamed items stay where they are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُحذف أي شيء ولا يُستبدل بنسخة أقدم. وتبقى العناصر المنقولة والمُعاد تسميتها في أماكنها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet slettes eller overskrives med en ældre kopi. Flyttede og omdøbte emner bliver, hvor de er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts gelöscht oder mit einer älteren Kopie überschrieben. Verschobene und umbenannte Objekte bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se elimina nada ni se sobrescribe ningún archivo con una copia más antigua. Los ítems movidos o renombrados se quedan donde están."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään ei poisteta eikä korvata vanhemmalla kopiolla. Siirretyt ja uudelleennimetyt kohteet pysyvät paikoillaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est supprimé ni remplacé par une copie plus ancienne. Les éléments déplacés et renommés restent où ils sont."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न कुछ डिलीट होता है, न किसी चीज़ को पुरानी कॉपी से ओवरराइट किया जाता है। स्थानांतरित और पुनर्नामित आइटम जहाँ हैं, वहीं रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang dihapus atau ditimpa dengan salinan yang lebih lama. Item yang dipindahkan dan diubah namanya tetap di tempatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla viene eliminato o sovrascritto con una copia meno recente. Gli elementi spostati e rinominati restano dove sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も削除されず、古いコピーで上書きされることもありません。移動や名称変更された項目はそのままの場所に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 삭제되거나 이전 사본으로 덮어쓰이지 않습니다. 이동 및 이름 변경된 항목은 현재 위치에 그대로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting slettes eller overskrives med en eldre kopi. Flyttede og omdøpte objekter blir liggende der de er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt niets verwijderd of overschreven met een oudere kopie. Verplaatste en hernoemde onderdelen blijven waar ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie zostanie usunięte ani zastąpione starszą kopią. Przeniesione i przemianowane rzeczy pozostaną na swoich miejscach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é apagado nem substituído por uma cópia mais antiga. Itens movidos e renomeados ficam onde estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не удаляется и не перезаписывается более старой копией. Перемещенные и переименованные объекты остаются на своих местах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget raderas eller skrivs över med en äldre kopia. Flyttade och omdöpta objekt ligger kvar där de är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะไม่มีการลบหรือเขียนทับด้วยสำเนาที่เก่ากว่า รายการที่ถูกย้ายและเปลี่ยนชื่อจะอยู่ที่เดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şey silinmez ya da daha eski bir kopyayla değiştirilmez. Taşınan ve yeniden adlandırılan öğeler oldukları yerde kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì bị xóa hoặc bị ghi đè bằng bản cũ hơn. Các mục đã di chuyển và đổi tên vẫn ở nguyên vị trí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会删除任何内容，也不会用较旧的副本覆盖。已移动和重新命名的项目保持原位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會刪除任何內容，也不會以較舊的副本覆寫。已搬移和重新命名的項目會保留在原位。"
          }
        }
      }
    },
    "Nothing to Copy" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد ما يُنسخ"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet at kopiere"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu kopieren"
          }
