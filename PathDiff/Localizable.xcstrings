    "SHA-256 and MD5 of each file, to verify copies byte for byte or check them against other tools." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموعا SHA-256 وMD5 لكل ملف، للتحقق من النسخ بايتًا ببايت أو مقارنتها بأدوات أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
