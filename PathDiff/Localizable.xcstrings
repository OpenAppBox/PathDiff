    "Only in the left folder, so missing from the right. A missing folder is shown as one entry with its file count." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موجود في المجلد الأيسر فقط، لذا فهو مفقود من الأيمن. ويُعرض المجلد المفقود كإدخال واحد مع عدد ملفاته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun i venstre mappe og mangler derfor til højre. En manglende mappe vises som én post med antallet af filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur im linken Ordner, fehlt also rechts. Ein fehlender Ordner wird als ein Eintrag mit seiner Dateianzahl angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo está en la carpeta izquierda, así que falta en la derecha. Una carpeta que falta se muestra como una sola entrada con su número de archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain vasemmassa kansiossa, joten puuttuu oikealta. Puuttuva kansio näytetään yhtenä merkintänä tiedostomäärineen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement dans le dossier de gauche, donc manquant à droite. Un dossier manquant apparaît comme une seule entrée accompagnée de son nombre de fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल बाएँ फ़ोल्डर में, इसलिए दाएँ फ़ोल्डर में अनुपस्थित। अनुपस्थित फ़ोल्डर अपनी फ़ाइलों की संख्या के साथ एक प्रविष्टि के रूप में दिखाया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya ada di folder kiri, belum ada di folder kanan. Folder yang belum ada ditampilkan sebagai satu entri beserta jumlah filenya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presente solo nella cartella di sinistra, quindi mancante a destra. Una cartella mancante viene mostrata come un’unica voce con il numero dei suoi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左のフォルダにのみあり、右からは欠落しています。欠落しているフォルダは、ファイル数とともに1つの項目として表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 폴더에만 있으므로 오른쪽에서 누락되었습니다. 누락된 폴더는 파일 수와 함께 하나의 항목으로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare i venstre mappe, og mangler derfor til høyre. En manglende mappe vises som én oppføring med antall filer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen in de linkermap, dus ontbrekend in de rechtermap. Een ontbrekende map wordt getoond als één vermelding met het aantal bestanden erin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko w lewym folderze, więc brakuje w prawym. Brakujący folder jest pokazywany jako jeden wpis z liczbą plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas na pasta da esquerda, portanto ausente na direita. Uma pasta ausente aparece como uma única entrada com o número de arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть только в левой папке, поэтому отсутствует в правой. Отсутствующая папка показывается одной записью с количеством файлов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finns bara i den vänstra mappen och saknas alltså till höger. En saknad mapp visas som en enda post med sitt antal filer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเฉพาะในโฟลเดอร์ซ้าย จึงขาดหายจากฝั่งขวา โฟลเดอร์ที่ขาดหายจะแสดงเป็นรายการเดียวพร้อมจำนวนไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca sol klasörde, yani sağda eksik. Eksik bir klasör, dosya sayısıyla birlikte tek bir kayıt olarak gösterilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ có trong thư mục bên trái, nên bị thiếu ở bên phải. Thư mục bị thiếu được hiển thị thành một mục kèm số lượng tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在左侧文件夹中，因此右侧缺失。缺失的文件夹显示为一个条目，并附带其文件数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在左側檔案夾中，因此右側缺少。缺少的檔案夾會顯示為一個項目，並附上檔案數量。"
          }
        }
      }
    },
