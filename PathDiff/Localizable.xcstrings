    "Replace the older copy of each modified file with the newer one" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدال النسخة الأقدم من كل ملف معدّل بالنسخة الأحدث"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstat den ældre kopi af hver ændret fil med den nyere"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Kopie jeder geänderten Datei durch die neuere ersetzen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar la copia más antigua de cada archivo modificado por la más reciente"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaa kunkin muutetun tiedoston vanhempi kopio uudemmalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer la copie la plus ancienne de chaque fichier modifié par la plus récente"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर संशोधित फ़ाइल की पुरानी कॉपी को नई कॉपी से बदलें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganti salinan yang lebih lama dari setiap file yang diubah dengan yang lebih baru"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci la copia meno recente di ogni file modificato con quella più recente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更された各ファイルの古いコピーを新しいコピーで置き換える"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수정된 각 파일의 이전 사본을 최신 사본으로 대치"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatt den eldre kopien av hver endrede fil med den nyere"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De oudere kopie van elk gewijzigd bestand vervangen door de nieuwere"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastąp starszą kopię każdego zmienionego pliku nowszą"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir a cópia mais antiga de cada arquivo modificado pela mais recente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменять более старую копию каждого измененного файла более новой"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersätt den äldre kopian av varje ändrad fil med den nyare"
