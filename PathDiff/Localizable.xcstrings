          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีไฟล์เดียวกัน (หรือที่แก้ไขเล็กน้อย) อยู่ที่เส้นทางอื่น โฟลเดอร์ที่เปลี่ยนชื่อทั้งโฟลเดอร์จะแสดงเป็นรายการเดียว"
