            "value" : "“%2$@” klasöründeki “%1$@” öğesi Çöp Sepeti’ne taşınsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển “%@” trong “%@” vào Thùng rác?"
          }
