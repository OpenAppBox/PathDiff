    "The text is the same; the files differ only in line endings, encoding, byte-order mark or a trailing newline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النص متطابق؛ ولا يختلف الملفان إلا في نهايات الأسطر أو الترميز أو علامة ترتيب البايت أو سطر جديد في النهاية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten er den samme; filerne adskiller sig kun ved linjeskift, tegnkodning, byte order mark (BOM) eller et afsluttende linjeskift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text ist gleich; die Dateien unterscheiden sich nur in Zeilenenden, Codierung, Byte-Order-Mark oder einem abschließenden Zeilenumbruch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto es el mismo; los archivos solo difieren en los finales de línea, la codificación, la marca de orden de bytes o un salto de línea final."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksti on sama; tiedostot eroavat vain rivinvaihtojen, merkistökoodauksen, BOM-merkin tai lopun rivinvaihdon osalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte est le même ; les fichiers ne diffèrent que par les fins de ligne, l’encodage, l’indicateur d’ordre des octets (BOM) ou un saut de ligne final."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट समान है; फ़ाइलें केवल पंक्ति-अंत, एन्कोडिंग, बाइट-ऑर्डर मार्क या अंतिम न्यूलाइन में भिन्न हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksnya sama; file hanya berbeda dalam akhir baris, enkode, byte-order mark, atau baris baru di akhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo è lo stesso; i file differiscono solo per fine riga, codifica, indicatore dell’ordine dei byte (BOM) o a capo finale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストは同じです。改行コード、エンコーディング、BOM、または末尾の改行だけが異なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트는 같으며, 파일은 줄 바꿈 문자, 인코딩, 바이트 순서 표시 또는 마지막 줄 바꿈만 다릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten er den samme. Filene er bare forskjellige i linjeslutt, tegnkoding, BOM eller et avsluttende linjeskift."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tekst is hetzelfde; de bestanden verschillen alleen in regeleinden, codering, byte-order mark of een nieuwe regel aan het einde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst jest taki sam; pliki różnią się tylko znakami końca wiersza, kodowaniem, znacznikiem kolejności bajtów (BOM) lub znakiem nowego wiersza na końcu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto é o mesmo; os arquivos diferem apenas nos finais de linha, na codificação, na marca de ordem de bytes ou em uma quebra de linha final."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст одинаковый; файлы различаются только окончаниями строк, кодировкой, меткой порядка байтов или переводом строки в конце."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texten är densamma. Filerna skiljer sig bara åt i radslut, teckenkodning, byteordningsmarkering (BOM) eller en avslutande radbrytning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความเหมือนกัน ไฟล์ต่างกันเพียงตัวจบบรรทัด การเข้ารหัส เครื่องหมายลำดับไบต์ (BOM) หรือการขึ้นบรรทัดใหม่ท้ายไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin aynı; dosyalar yalnızca satır sonları, kodlama, bayt sırası işareti ya da sondaki yeni satır bakımından farklı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Văn bản giống nhau; các tệp chỉ khác nhau ở ký tự kết thúc dòng, bảng mã, dấu thứ tự byte (BOM) hoặc dòng mới ở cuối tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本内容相同；文件仅在换行符、编码、字节顺序标记或末尾换行符上有所不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字相同；檔案只在換行字元、編碼、位元組順序記號（BOM）或結尾換行上有所不同。"
          }
        }
      }
    },
