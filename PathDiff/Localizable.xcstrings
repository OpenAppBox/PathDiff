    "Choose an entry to see what changed, when, and where — and to revert it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر إدخالًا لمعرفة ما تغيّر ومتى وأين، ولإرجاعه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en post for at se, hvad der blev ændret, hvornår og hvor – og for at tilbageføre den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Eintrag, um zu sehen, was sich wann und wo geändert hat – und um es zurückzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una entrada para ver qué cambió, cuándo y dónde, y para revertirla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse merkintä nähdäksesi, mitä muuttui, milloin ja missä – ja palauttaaksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une entrée pour voir ce qui a changé, quand et où, et pour la restaurer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या, कब और कहाँ बदला, यह देखने और उसे वापस लौटाने के लिए कोई प्रविष्टि चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih entri untuk melihat apa yang berubah, kapan, dan di mana — serta untuk mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una voce per vedere cosa è cambiato, quando e dove, e per ripristinarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目を選択すると、何がいつどこで変更されたかが表示され、その変更を戻すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 선택하면 무엇이 언제 어디서 변경되었는지 확인하고 복귀할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en oppføring for å se hva som ble endret, når og hvor – og for å tilbakestille det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een vermelding om te zien wat er is gewijzigd, wanneer en waar – en om het terug te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz wpis, aby zobaczyć, co się zmieniło, kiedy i gdzie – oraz aby wycofać tę zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma entrada para ver o que mudou, quando e onde — e para revertê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите запись, чтобы увидеть, что изменилось, когда и где, и откатить это изменение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en post för att se vad som ändrades, när och var – och för att återställa den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกรายการเพื่อดูว่ามีอะไรเปลี่ยนแปลง เมื่อไร และที่ไหน รวมถึงเพื่อย้อนกลับรายการนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neyin, ne zaman ve nerede değiştiğini görmek ve geri döndürmek için bir kayıt seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một mục nhập để xem nội dung đã thay đổi, thời điểm và vị trí — và để hoàn nguyên thay đổi đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个条目，即可查看更改了什么、何时更改以及在何处更改，并可将其复原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一筆記錄，即可查看變更的內容、時間和位置，並可將其回復。"
          }
        }
      }
    },
