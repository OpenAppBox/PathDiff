    "Reverts that rename items can’t be reverted again." : {
      "comment" : "A history revert that itself renames items cannot subsequently be reverted. Other history reverts may be reverted; preserve this restriction.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إرجاع عمليات الإرجاع التي تعيد تسمية العناصر مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbageførsler, der omdøber emner, kan ikke tilbageføres igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurücksetzungen, die Objekte umbenennen, können nicht erneut zurückgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reversiones que cambian el nombre de ítems no se pueden volver a revertir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautuksia, jotka nimeävät kohteita uudelleen, ei voi palauttaa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une restauration qui renomme des éléments ne peut pas être restaurée à son tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन वापसी कार्रवाइयों से आइटम के नाम बदलते हैं, उन्हें फिर से वापस नहीं लौटाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengembalian yang mengubah nama item tidak dapat dikembalikan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ripristini che rinominano elementi non possono essere a loro volta ripristinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目の名称を変更する「戻す」操作は、もう一度戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목의 이름을 변경하는 복귀 작업은 다시 복귀할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbakestillinger som gir objekter nytt navn, kan ikke tilbakestilles igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugzettingen die namen van onderdelen wijzigen, kunnen niet opnieuw worden teruggezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wycofań, które zmieniają nazwy rzeczy, nie można ponownie wycofać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reversões que renomeiam itens não podem ser revertidas novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откаты, которые переименовывают объекты, нельзя откатить повторно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställningar som byter namn på objekt kan inte återställas igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การย้อนกลับที่เปลี่ยนชื่อรายการไม่สามารถย้อนกลับซ้ำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğeleri yeniden adlandıran geri döndürme işlemleri tekrar geri döndürülemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể hoàn nguyên lại các lần hoàn nguyên có đổi tên mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "涉及重新命名项目的复原操作无法再次复原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會重新命名項目的回復無法再次回復。"
          }
        }
      }
    },
