        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“सिस्टम” सिस्टम सेटिंग्ज़ में चुनी गई दिखावट का पालन करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem mengikuti tampilan yang dipilih di Pengaturan Sistem."
