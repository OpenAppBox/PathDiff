    "This file only exists on the other side. Copy it over first to edit both versions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الملف موجود على الجانب الآخر فقط. انسخه أولًا لتحرير النسختين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne fil findes kun på den anden side. Kopier den over først for at redigere begge versioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist nur auf der anderen Seite vorhanden. Kopiere sie zuerst hinüber, um beide Versionen zu bearbeiten."
