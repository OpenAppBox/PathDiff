          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna muokatut puolet (⌘S). Tallennuksen voi perua tai palauttaa historiasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
