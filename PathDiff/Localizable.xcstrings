    "The backup for this change is no longer available, so it can’t be reverted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد النسخة الاحتياطية لهذا التغيير متاحة، لذا يتعذّر إرجاعه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopien af denne ændring er ikke længere tilgængelig, så den kan ikke tilbageføres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup für diese Änderung ist nicht mehr verfügbar, daher kann sie nicht zurückgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad de este cambio ya no está disponible, así que no se puede revertir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän muutoksen varmuuskopio ei ole enää saatavilla, joten muutosta ei voi palauttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde de cette modification n’est plus disponible ; celle-ci ne peut donc pas être restaurée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस परिवर्तन का बैकअप अब उपलब्ध नहीं है, इसलिए इसे वापस नहीं लौटाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan untuk perubahan ini sudah tidak tersedia, sehingga perubahan tidak dapat dikembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup di questa modifica non è più disponibile, quindi non è possibile ripristinarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この変更のバックアップは利用できなくなったため、戻すことはできません。"
          }
        },
        "ko" : {
