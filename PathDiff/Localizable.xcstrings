        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu öğeler karşılaştırmada eksik ya da değişmiş olarak görünüyor. İzinlerini denetleyip yenileyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục này bị thiếu trong so sánh hoặc được hiển thị là đã sửa đổi. Hãy kiểm tra quyền truy cập của chúng, rồi làm mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些项目未纳入比较，或显示为已修改。请检查它们的权限，然后刷新。"
