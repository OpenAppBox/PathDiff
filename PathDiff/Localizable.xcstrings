    "“%@” changed on disk after it was loaded. The diff has been reloaded; please review it and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر «%@» على القرص بعد تحميله. تمت إعادة تحميل عرض الفروق؛ يُرجى مراجعته والمحاولة مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« blev ændret på disken, efter at den blev indlæst. Diffen er indlæst igen. Gennemgå den, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde nach dem Laden auf dem Datenträger geändert. Der Diff wurde neu geladen. Bitte prüfe ihn und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ha cambiado en el disco después de cargarse. Se han vuelto a cargar las diferencias; revísalas e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” muuttui levyllä latauksen jälkeen. Diff on ladattu uudelleen; tarkista se ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a été modifié sur le disque après son chargement. Le diff a été rechargé ; vérifiez-le, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोड होने के बाद डिस्क पर “%@” में परिवर्तन हुआ। अंतर फिर से लोड कर दिया गया है; कृपया इसकी समीक्षा करें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” berubah di disk setelah dimuat. Diff telah dimuat ulang; tinjau kembali, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è stato modificato sul disco dopo il caricamento. Il diff è stato ricaricato; controllalo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は読み込み後にディスク上で変更されました。差分を読み込み直しました。内容を確認してから、もう一度実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 파일을 불러온 후 디스크에서 변경되었습니다. 차이점을 다시 불러왔으니 검토한 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ble endret på disken etter at den ble lastet inn. Diffen er lastet inn på nytt. Se gjennom den, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is na het laden gewijzigd op schijf. De diff is opnieuw geladen; controleer deze en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik „%@” zmienił się na dysku po wczytaniu. Widok różnic został ponownie wczytany; przejrzyj go i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” foi alterado no disco depois de ser carregado. As diferenças foram recarregadas; revise-as e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%@» изменился на диске после загрузки. Сравнение перезагружено; проверьте его и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” ändrades på disken efter att den lästes in. Diffen har lästs in igen. Granska den och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” มีการเปลี่ยนแปลงบนดิสก์หลังจากโหลดแล้ว ความแตกต่างถูกโหลดใหม่แล้ว โปรดตรวจทานแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” yüklendikten sonra diskte değişti. Farklar yeniden yüklendi; lütfen gözden geçirip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” đã thay đổi trên ổ đĩa sau khi được tải. Khác biệt đã được tải lại; vui lòng xem lại rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”在载入后已在磁盘上更改。差异已重新载入；请检查后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在載入後已在磁碟上變更。差異已重新載入；請檢閱後再試一次。"
          }
        }
      }
    },
    "“%@” is %@ on the left and %@ on the right." : {
      "comment" : "The second and third arguments are item kinds such as “a folder” or “a file”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» عبارة عن %2$@ في اليسار و%3$@ في اليمين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%1$@« er %2$@ til venstre og %3$@ til højre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist links %2$@ und rechts %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is %2$@ on the left and %3$@ on the right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” es %2$@ a la izquierda y %3$@ a la derecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” on vasemmalla %2$@ ja oikealla %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est %2$@ à gauche et %3$@ à droite."
          }
        },
        "hi" : {
          "stringUnit" : {
