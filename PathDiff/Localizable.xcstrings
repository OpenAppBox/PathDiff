    "Quit anyway and lose them, or cancel and save them first (⌘S)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِ التطبيق على أي حال وافقدها، أو ألغِ واحفظها أولًا (⌘S)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut alligevel, og mist dem, eller annuller, og arkiver dem først (⌘S)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende trotzdem und verwirf sie oder brich ab und sichere sie zuerst (⌘S)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de todos modos y piérdelas, o cancela y guárdalas antes (⌘S)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta silti ja menetä ne, tai kumoa ja tallenna ne ensin (⌘S)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez quand même et perdez-les, ou annulez et enregistrez-les d’abord (⌘S)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर भी बंद करें और उन्हें खो दें, या रद्द करें और पहले उन्हें सहेजें (⌘S)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap keluar dan kehilangan editan, atau batalkan dan simpan terlebih dahulu (⌘S)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esci comunque e perdile, oppure annulla e salvale prima (⌘S)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのまま終了して編集内容を破棄するか、キャンセルして先に保存してください（⌘S）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그래도 종료하여 편집 내용을 잃거나, 취소한 다음 먼저 저장(⌘S)하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt likevel og mist dem, eller avbryt og arkiver dem først (⌘S)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop toch en verlies ze, of annuleer en bewaar ze eerst (⌘S)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ mimo to i utrać zmiany lub anuluj i najpierw je zachowaj (⌘S)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre mesmo assim e perca-as, ou cancele e salve-as primeiro (⌘S)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно завершить работу и потерять их или отменить и сначала сохранить их (⌘S)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta ändå och förlora dem, eller avbryt och spara dem först (⌘S)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกต่อไปและสูญเสียการแก้ไข หรือยกเลิกแล้วบันทึกก่อน (⌘S)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yine de çıkıp bunları kaybedin ya da vazgeçip önce kaydedin (⌘S)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn thoát và mất nội dung sửa, hoặc hủy và lưu trước (⌘S)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍然退出并丢失这些编辑，或者取消并先存储（⌘S）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍要結束並放棄編輯，或取消並先儲存（⌘S）。"
          }
        }
      }
    },
