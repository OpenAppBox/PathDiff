    "Each folder gets what only the other has; the newer copy of a changed file wins." : {
      "comment" : "Two-way folder merge summary. Copy items absent from either folder and replace the older copy of differing files with the newer copy by modification date; simultaneous edits are skipped as explained in the merge help.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنسخ العناصر الناقصة إلى كل مجلد. وللملفات المختلفة، تحل النسخة الأحدث محل الأقدم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manglende emner kopieres til hver mappe. Hvis filer er forskellige, erstatter den nyere kopi den ældre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlende Objekte werden in den jeweiligen Ordner kopiert. Bei unterschiedlichen Dateien ersetzt die neuere Kopie die ältere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy missing items to each folder. For files that differ, replace the older copy with the newer one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se copian en cada carpeta los ítems que le faltan. Si los archivos difieren, la copia más reciente reemplaza a la más antigua."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuttuvat kohteet kopioidaan kumpaankin kansioon. Eroavista tiedostoista uudempi kopio korvaa vanhemman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments manquants sont copiés dans chaque dossier. Si les fichiers diffèrent, la copie la plus récente remplace la plus ancienne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर फ़ोल्डर में वे आइटम कॉपी होते हैं जो उसमें नहीं हैं। फ़ाइलें अलग होने पर नई कॉपी पुरानी कॉपी की जगह लेती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item yang belum ada disalin ke masing-masing folder. Jika isi file berbeda, salinan yang lebih baru menggantikan yang lebih lama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi mancanti vengono copiati in ciascuna cartella. Se i file sono diversi, la copia più recente sostituisce quella meno recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各フォルダに不足している項目をコピーします。内容が異なるファイルは、新しいほうのコピーで古いほうを置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 폴더에 없는 항목을 복사합니다. 내용이 다른 파일은 최신 사본으로 이전 사본을 대치합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manglende objekter kopieres til hver mappe. Hvis filene er forskjellige, erstatter den nyere kopien den eldre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontbrekende onderdelen worden naar elke map gekopieerd. Bij verschillende bestanden vervangt de nieuwere kopie de oudere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakujące rzeczy są kopiowane do każdego folderu. Jeśli pliki się różnią, nowsza kopia zastępuje starszą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens ausentes são copiados para cada pasta. Se os arquivos forem diferentes, a cópia mais recente substitui a mais antiga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостающие объекты копируются в каждую папку. Если файлы различаются, более новая копия заменяет более старую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saknade objekt kopieras till varje mapp. Om filerna skiljer sig åt ersätter den nyare kopian den äldre."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คัดลอกรายการที่ขาดไปยังแต่ละโฟลเดอร์ หากไฟล์ต่างกัน สำเนาที่ใหม่กว่าจะแทนที่สำเนาที่เก่ากว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her klasöre eksik öğeler kopyalanır. İçeriği farklı dosyalarda daha yeni kopya, eski kopyanın yerini alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục còn thiếu được sao chép vào từng thư mục. Nếu nội dung tệp khác nhau, bản mới hơn sẽ thay thế bản cũ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向每个文件夹拷贝其缺少的项目。对于内容不同的文件，用较新的副本替换较旧的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將缺少的項目拷貝到各自的檔案夾。內容不同的檔案會以較新的副本取代較舊的副本。"
          }
        }
      }
    },
    "Each folder’s own .gitignore files apply too (Comparison settings)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق أيضًا ملفات .gitignore الخاصة بكل مجلد (إعدادات المقارنة)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver mappes egne .gitignore-filer gælder også (indstillingerne for Sammenligning)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eigenen .gitignore-Dateien jedes Ordners gelten ebenfalls (Einstellungen „Vergleich“)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se aplican los archivos .gitignore de cada carpeta (ajustes de Comparación)."
          }
        },
        "fi" : {
          "stringUnit" : {
