          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten sam plik (lub nieznacznie zmieniony) istnieje pod inną ścieżką. Całe przemianowane foldery są pokazywane jako jeden wpis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
