    "Save the edited sides (⌘S). Saving can be undone or reverted from the History." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفظ الجانبين المعدَّلين (⌘S). يمكن التراجع عن الحفظ أو إرجاعه من السجل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiver de redigerede sider (⌘S). Arkiveringen kan fortrydes eller tilbageføres fra historikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitete Seiten sichern (⌘S). Das Sichern lässt sich widerrufen oder im Verlauf zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
