    "Relaunch PathDiff to switch to %@. Open comparisons reopen automatically." : {
      "comment" : "Argument is the selected language setting’s localized title. It can be System Language as well as a language name. Avoid grammar that only works with actual language names.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعِد تشغيل PathDiff للتبديل إلى %@. ستُفتح المقارنات المفتوحة من جديد تلقائيًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genstart PathDiff for at skifte til %@. Åbne sammenligninger åbnes automatisk igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte PathDiff neu, um auf %@ umzustellen. Geöffnete Vergleiche werden automatisch wieder geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a abrir PathDiff para cambiar a %@. Las comparaciones abiertas se restaurarán automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda kieleksi %@ käynnistämällä PathDiff uudelleen. Avoimet vertailut avautuvat automaattisesti uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relancez PathDiff pour passer en %@. Les comparaisons ouvertes se rouvrent automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर स्विच करने के लिए PathDiff को फिर से लॉन्च करें। खुली तुलनाएँ अपने-आप फिर से खुल जाएँगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka ulang PathDiff untuk beralih ke %@. Perbandingan yang sedang terbuka akan dibuka kembali secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavvia PathDiff per passare alla lingua %@. I confronti aperti vengono riaperti automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に切り替えるには、PathDiffを再起動してください。開いている比較は自動的に再び開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 언어(%@)로 전환하려면 PathDiff를 다시 실행하십시오. 열려 있는 비교는 자동으로 다시 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start PathDiff på nytt for å bytte til %@. Åpne sammenligninger åpnes automatisk igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start PathDiff opnieuw op om over te schakelen naar %@. Geopende vergelijkingen worden automatisch weer geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom PathDiff ponownie, aby zmienić język na: %@. Otwarte porównania zostaną automatycznie otwarte ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reabra o PathDiff para mudar para %@. As comparações abertas são reabertas automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустите PathDiff, чтобы переключиться на язык «%@». Открытые сравнения откроются автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta om PathDiff för att byta till %@. Öppna jämförelser öppnas igen automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด PathDiff ใหม่เพื่อสลับไปใช้ %@ การเปรียบเทียบที่เปิดอยู่จะเปิดขึ้นอีกครั้งโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen dile (%@) geçmek için PathDiff’i yeniden başlatın. Açık karşılaştırmalar kendiliğinden yeniden açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khởi chạy lại PathDiff để chuyển sang %@. Các so sánh đang mở sẽ tự động mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
