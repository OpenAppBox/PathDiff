    "System follows the appearance chosen in System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع خيار «النظام» المظهر المحدد في إعدادات النظام."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»System« følger det udseende, der er valgt i Systemindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ übernimmt das in den Systemeinstellungen gewählte Erscheinungsbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sistema” usa el aspecto elegido en Ajustes del Sistema."
