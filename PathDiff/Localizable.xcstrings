    "Rename the item on one side so both folders have it at the same path. Undo with ⌘Z." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعِد تسمية العنصر على أحد الجانبين ليكون في المسار نفسه في كلا المجلدين. للتراجع، استخدم ⌘Z."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omdøb emnet på den ene side, så det har samme sti i begge mapper. Fortryd med ⌘Z."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benennt das Objekt auf einer Seite um, sodass es in beiden Ordnern am selben Pfad liegt. Mit ⌘Z widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renombra el ítem en un lado para que ambas carpetas lo tengan en la misma ruta. Deshaz con ⌘Z."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimeä kohde uudelleen toisella puolella, jotta se on molemmissa kansioissa samassa polussa. Peru painamalla ⌘Z."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renommer l’élément d’un côté pour que les deux dossiers l’aient au même chemin. Annulez avec ⌘Z."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ओर आइटम का नाम बदलें, ताकि दोनों फ़ोल्डरों में वह एक ही पाथ पर हो। ⌘Z से पूर्ववत करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah nama item di satu sisi agar kedua folder memilikinya di jalur yang sama. Urungkan dengan ⌘Z."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinomina l’elemento su un lato, così entrambe le cartelle lo hanno nello stesso percorso. Annulla con ⌘Z."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のフォルダで同じパスになるように、一方の側の項目の名称を変更します。⌘Zで取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 폴더에서 같은 경로에 있도록 한쪽 항목의 이름을 변경합니다. ⌘Z로 실행 취소할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi objektet nytt navn på én side, slik at det har samme bane i begge mappene. Angre med ⌘Z."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig de naam van het onderdeel aan één kant, zodat het in beide mappen op hetzelfde pad staat. Maak ongedaan met ⌘Z."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień nazwę rzeczy po jednej stronie, tak aby w obu folderach miała tę samą ścieżkę. Cofnij za pomocą ⌘Z."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renomeie o item em um dos lados para que ele fique no mesmo caminho nas duas pastas. Desfaça com ⌘Z."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переименовать объект на одной стороне, чтобы в обеих папках он находился по одному и тому же пути. Отменить можно с помощью ⌘Z."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt namn på objektet på ena sidan så att det har samma sökväg i båda mapparna. Ångra med ⌘Z."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนชื่อรายการในฝั่งหนึ่งเพื่อให้ทั้งสองโฟลเดอร์มีรายการนั้นที่เส้นทางเดียวกัน เลิกทำด้วย ⌘Z"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğeyi bir tarafta yeniden adlandırarak iki klasörde de aynı yola getirin. ⌘Z ile geri alabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi tên mục ở một bên để cả hai thư mục có mục đó ở cùng đường dẫn. Hoàn tác bằng ⌘Z."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一侧重新命名该项目，使它在两个文件夹中的路径相同。可用 ⌘Z 撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其中一側重新命名項目，讓它在兩個檔案夾中位於相同路徑。可使用 ⌘Z 還原。"
          }
        }
      }
    },
