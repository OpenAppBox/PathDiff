            "value" : "เฝ้าดูโฟลเดอร์และอัปเดตโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasörleri izle ve kendiliğinden güncelle"
          }
        },
        "vi" : {
