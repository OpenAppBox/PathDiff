    "Renews automatically every year until you cancel." : {
      "comment" : "Subscription offer: the renewal terms under the yearly price",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد تلقائيًا كل عام حتى تلغيه."
