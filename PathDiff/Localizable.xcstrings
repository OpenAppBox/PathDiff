    "The first week is free. Cancel before it ends and you won’t be charged." : {
      "comment" : "Subscription offer: the 1-week free trial, shown smaller than the price and only to people eligible for it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسبوع الأول مجاني. ألغِ قبل انتهائه ولن يتم تحصيل أي رسوم منك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den første uge er gratis. Opsig, inden den slutter, så bliver du ikke opkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Woche ist kostenlos. Kündige vor ihrem Ende, dann zahlst du nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera semana es gratis. Cancela antes de que termine y no se te cobrará nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensimmäinen viikko on ilmainen. Peruuta ennen sen päättymistä, niin sinulta ei veloiteta mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première semaine est gratuite. Annulez avant la fin et vous ne serez pas facturé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहला हफ़्ता मुफ़्त है। इसके ख़त्म होने से पहले रद्द करें, तो आपसे कोई शुल्क नहीं लिया जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minggu pertama gratis. Batalkan sebelum berakhir dan Anda tidak akan dikenai biaya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
