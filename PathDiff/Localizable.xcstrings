    "Syncs, copies, moves, edits and trash operations made with PathDiff appear here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا عمليات المزامنة والنسخ والنقل والتحرير والنقل إلى سلة المهملات التي تُجرى باستخدام PathDiff."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringer, kopieringer, flytninger, redigeringer og flytninger til papirkurven foretaget med PathDiff vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierungen, Kopien, Verschiebungen, Bearbeitungen und Papierkorbvorgänge in PathDiff erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las sincronizaciones, copias, movimientos, ediciones y envíos a la Papelera hechos con PathDiff."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PathDiffillä tehdyt synkronoinnit, kopioinnit, siirrot, muokkaukset ja roskakoriin siirrot näkyvät tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les synchronisations, copies, déplacements, modifications et placements dans la corbeille effectués avec PathDiff apparaissent ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PathDiff से किए गए सिंक, कॉपी, स्थानांतरण, संपादन और ट्रैश ऑपरेशन यहाँ दिखाई देते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi, penyalinan, pemindahan, pengeditan, dan pemindahan ke Tong Sampah yang dilakukan dengan PathDiff muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui vengono mostrate le sincronizzazioni, le copie, gli spostamenti, le modifiche e gli spostamenti nel Cestino effettuati con PathDiff."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PathDiffで行った同期、コピー、移動、編集、ゴミ箱への移動がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PathDiff로 수행한 동기화, 복사, 이동, 편집 및 휴지통 작업이 여기에 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringer, kopieringer, flyttinger, redigeringer og flyttinger til papirkurven som er utført med PathDiff, vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisaties, kopieën, verplaatsingen, bewerkingen en Prullenmand-acties die met PathDiff zijn uitgevoerd, verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawią się synchronizacje, kopie, przeniesienia, edycje i przeniesienia do Kosza wykonane w PathDiff."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizações, cópias, movimentações, edições e envios para o Lixo feitos com o PathDiff aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появляются синхронизации, копирования, перемещения, правки и удаления в Корзину, выполненные в PathDiff."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringar, kopieringar, flyttar, redigeringar och flyttar till papperskorgen som görs med PathDiff visas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมข้อมูล การคัดลอก การย้าย การแก้ไข และการย้ายไปที่ถังขยะที่ทำด้วย PathDiff จะปรากฏที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PathDiff ile yapılan eşzamanlama, kopyalama, taşıma, düzenleme ve Çöp Sepeti’ne taşıma işlemleri burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thao tác đồng bộ hóa, sao chép, di chuyển, sửa và chuyển vào Thùng rác thực hiện bằng PathDiff sẽ xuất hiện tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 PathDiff 进行的同步、拷贝、移动、编辑和移到废纸篓操作会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 PathDiff 進行的同步、拷貝、搬移、編輯和丟到垃圾桶操作會顯示在這裡。"
          }
        }
      }
