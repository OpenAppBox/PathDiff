        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी फ़ाइल को इमेज के रूप में डीकोड नहीं किया जा सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua file tidak dapat didekode sebagai gambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno dei due file può essere decodificato come immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらのファイルも画像としてデコードできませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 파일 모두 이미지로 디코딩할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av filene kunne dekodes som bilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen van beide bestanden kon als afbeelding worden gedecodeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
