          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp .gitignore riêng của mỗi thư mục cũng được áp dụng (cài đặt So sánh)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
