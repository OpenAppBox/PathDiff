    "Same pixels where they overlap, but the sizes differ" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البكسلات متطابقة حيث تتداخل الصورتان، لكن الحجمين مختلفان"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme pixels, hvor de overlapper, men størrelserne er forskellige"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleiche Pixel im überlappenden Bereich, aber unterschiedliche Größen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mismos píxeles donde se superponen, pero con tamaños distintos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samat pikselit päällekkäisellä alueella, mutta koot eroavat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mêmes pixels là où les images se superposent, mais les tailles diffèrent"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ वे ओवरलैप होते हैं वहाँ पिक्सेल समान हैं, लेकिन आकार भिन्न हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piksel sama di bagian yang tumpang tindih, tetapi ukurannya berbeda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stessi pixel dove si sovrappongono, ma le dimensioni sono diverse"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重なる部分のピクセルは同じですが、サイズが異なります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "겹치는 부분의 픽셀은 같지만 크기가 다름"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme piksler der de overlapper, men størrelsene er forskjellige"
