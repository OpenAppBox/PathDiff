    "Move “%@” in “%@” to the Trash?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد نقل «%1$@» في «%2$@» إلى سلة المهملات؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du flytte »%1$@« i »%2$@« til papirkurven?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ in „%2$@“ in den Papierkorb legen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move “%1$@” in “%2$@” to the Trash?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Trasladar “%1$@” de “%2$@” a la Papelera?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirretäänkö ”%1$@” roskakoriin kansiosta ”%2$@”?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer « %1$@ » de « %2$@ » dans la corbeille ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%2$@” में “%1$@” को ट्रैश में ले जाएँ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindahkan “%@” di “%@” ke Tong Sampah?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi spostare nel Cestino «%1$@» in «%2$@»?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%2$@」内の「%1$@」をゴミ箱に入れますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%2$@’의 ‘%1$@’ 항목을 휴지통으로 이동하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du flytte «%1$@» i «%2$@» til papirkurven?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ in ‘%2$@’ naar de Prullenmand verplaatsen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieść „%1$@” z „%2$@” do Kosza?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover “%1$@” em “%2$@” para o Lixo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместить «%1$@» из «%2$@» в Корзину?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du flytta ”%1$@” i ”%2$@” till papperskorgen?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้าย “%1$@” ใน “%2$@” ไปที่ถังขยะหรือไม่"
