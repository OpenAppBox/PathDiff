    "Left: %@ · Right: %@. Files over %@ are compared but not shown line by line." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليسار: %1$@ · اليمين: %2$@. الملفات التي يتجاوز حجمها %3$@ تُقارَن ولكن لا تُعرض سطرًا بسطر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venstre: %1$@ · Højre: %2$@. Filer over %3$@ sammenlignes, men vises ikke linje for linje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links: %1$@ · Rechts: %2$@. Dateien über %3$@ werden verglichen, aber nicht zeilenweise angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left: %1$@ · Right: %2$@. Files over %3$@ are compared but not shown line by line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izquierda: %1$@ · Derecha: %2$@. Los archivos de más de %3$@ se comparan pero no se muestran línea a línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vasen: %1$@ · Oikea: %2$@. Tiedostot, joiden koko ylittää %3$@, verrataan, mutta niitä ei näytetä riveittäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gauche : %1$@ · Droite : %2$@. Les fichiers de plus de %3$@ sont comparés mais ne sont pas affichés ligne par ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बायाँ: %1$@ · दायाँ: %2$@। %3$@ से बड़ी फ़ाइलों की तुलना की जाती है, लेकिन उन्हें पंक्ति दर पंक्ति नहीं दिखाया जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiri: %@ · Kanan: %@. File di atas %@ dibandingkan tetapi tidak ditampilkan baris demi baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinistra: %1$@ · Destra: %2$@. I file più grandi di %3$@ vengono confrontati ma non mostrati riga per riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左：%1$@ · 右：%2$@。%3$@を超えるファイルは比較されますが、行ごとには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽: %1$@ · 오른쪽: %2$@. %3$@ 초과 파일은 비교되지만 줄 단위로 표시되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venstre: %1$@ · Høyre: %2$@. Filer over %3$@ sammenlignes, men vises ikke linje for linje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links: %1$@ · Rechts: %2$@. Bestanden groter dan %3$@ worden vergeleken, maar niet regel voor regel getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lewy: %1$@ · Prawy: %2$@. Pliki większe niż %3$@ są porównywane, ale nie są wyświetlane wiersz po wierszu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquerda: %1$@ · Direita: %2$@. Arquivos com mais de %3$@ são comparados, mas não são mostrados linha a linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слева: %1$@ · Справа: %2$@. Файлы больше %3$@ сравниваются, но не показываются построчно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänster: %1$@ · Höger: %2$@. Filer över %3$@ jämförs men visas inte rad för rad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ้าย: %1$@ · ขวา: %2$@ ไฟล์ที่ใหญ่กว่า %3$@ จะถูกเปรียบเทียบแต่ไม่แสดงทีละบรรทัด"
