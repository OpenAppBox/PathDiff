    "The folder “%@” can’t be read. It may have been moved, deleted or disconnected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعذّر قراءة المجلد «%@». ربما تم نقله أو حذفه أو فصله."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen »%@« kan ikke læses. Den er muligvis blevet flyttet, slettet eller frakoblet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „%@“ kann nicht gelesen werden. Er wurde möglicherweise verschoben, gelöscht oder getrennt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer la carpeta “%@”. Puede que se haya movido, eliminado o desconectado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansiota ”%@” ei voi lukea. Se on ehkä siirretty, poistettu tai irrotettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le dossier « %@ ». Il a peut-être été déplacé, supprimé ou déconnecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोल्डर “%@” पढ़ा नहीं जा सकता। हो सकता है कि इसे स्थानांतरित, डिलीट या डिस्कनेक्ट कर दिया गया हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder “%@” tidak dapat dibaca. Folder mungkin telah dipindahkan, dihapus, atau terputus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere la cartella «%@». Potrebbe essere stata spostata, eliminata o scollegata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ「%@」を読み込めません。移動、削除、または接続解除された可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 폴더를 읽을 수 없습니다. 이동되었거나 삭제되었거나 연결이 해제되었을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen «%@» kan ikke leses. Den kan ha blitt flyttet, slettet eller koblet fra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De map ‘%@’ kan niet worden gelezen. Mogelijk is deze verplaatst, verwijderd of losgekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać folderu „%@”. Mógł zostać przeniesiony, usunięty lub odłączony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler a pasta “%@”. Ela pode ter sido movida, apagada ou desconectada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается прочитать папку «%@». Возможно, она была перемещена, удалена или отключена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att läsa mappen ”%@”. Den kan ha flyttats, raderats eller kopplats från."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถอ่านโฟลเดอร์ “%@” ได้ โฟลเดอร์อาจถูกย้าย ลบ หรือตัดการเชื่อมต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” klasörü okunamıyor. Taşınmış, silinmiş ya da bağlantısı kesilmiş olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc thư mục “%@”. Thư mục có thể đã bị di chuyển, xóa hoặc ngắt kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
