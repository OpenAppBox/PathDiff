    "See exactly what’s different between two folders, then make them match." : {
      "comment" : "Subscription offer headline, under the app name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف بدقة ما الذي يختلف بين مجلدين، ثم اجعلهما متطابقين."
          }
        },
        "da" : {
          "stringUnit" : {
