    "Files in “%@” and “%@” are restored to how they were before this change. The revert is recorded in the history too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُستعاد الملفات في «%1$@» و«%2$@» إلى ما كانت عليه قبل هذا التغيير. ويُسجَّل الإرجاع في السجل أيضًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filerne i »%1$@« og »%2$@« gendannes, som de var før denne ændring. Tilbageførslen registreres også i historikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien in „%1$@“ und „%2$@“ werden auf den Stand vor dieser Änderung zurückgesetzt. Das Zurücksetzen wird ebenfalls im Verlauf festgehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files in “%1$@” and “%2$@” are restored to how they were before this change. The revert is recorded in the history too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de “%1$@” y “%2$@” se restaurarán al estado anterior a este cambio. La reversión también se registrará en el historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansioiden ”%1$@” ja ”%2$@” tiedostot palautetaan tilaan, jossa ne olivat ennen tätä muutosta. Myös palautus tallentuu historiaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de « %1$@ » et de « %2$@ » sont remis dans l’état où ils étaient avant cette modification. La restauration est également consignée dans l’historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” और “%2$@” की फ़ाइलें इस परिवर्तन से पहले की स्थिति में पुनर्स्थापित की जाएँगी। वापस लौटाने की यह कार्रवाई भी इतिहास में दर्ज होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File di “%@” dan “%@” dipulihkan ke keadaan sebelum perubahan ini. Pengembalian ini juga dicatat dalam riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file in «%1$@» e «%2$@» vengono riportati allo stato precedente a questa modifica. Anche il ripristino viene registrato nella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」と「%2$@」のファイルが、この変更の前の状態に戻されます。この操作も履歴に記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 및 ‘%2$@’의 파일이 이 변경 이전 상태로 복원됩니다. 복귀 작업도 기록에 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filene i «%1$@» og «%2$@» gjenopprettes slik de var før denne endringen. Tilbakestillingen registreres også i historikken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden in ‘%1$@’ en ‘%2$@’ worden teruggezet naar hoe ze vóór deze wijziging waren. Het terugzetten wordt ook in de geschiedenis vastgelegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki w „%1$@” i „%2$@” zostaną przywrócone do stanu sprzed tej zmiany. Wycofanie również zostanie zapisane w historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos em “%1$@” e “%2$@” voltam ao estado anterior a esta alteração. A reversão também fica registrada no histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы в «%1$@» и «%2$@» будут восстановлены в состояние до этого изменения. Откат также записывается в историю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filerna i ”%1$@” och ”%2$@” återställs till hur de var före den här ändringen. Återställningen registreras också i historiken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ใน “%1$@” และ “%2$@” จะถูกกู้คืนเป็นสถานะก่อนการเปลี่ยนแปลงนี้ การย้อนกลับจะถูกบันทึกไว้ในประวัติด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ve “%2$@” klasörlerindeki dosyalar bu değişiklikten önceki hâllerine döndürülür. Geri döndürme işlemi de geçmişe kaydedilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp trong “%@” và “%@” được khôi phục về trạng thái trước thay đổi này. Lần hoàn nguyên cũng được ghi lại trong lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”和“%2$@”中的文件将恢复到此更改之前的状态。此次复原也会记录在历史记录中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」和「%2$@」中的檔案會恢復成此變更之前的狀態。這次回復也會記錄在歷史記錄中。"
          }
        }
      }
    },
    "Files over 10 MB can’t be edited here" : {
      "localizations" : {
