          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng một tệp (hoặc tệp đã sửa đôi chút) có ở đường dẫn khác. Toàn bộ thư mục đã đổi tên được hiển thị thành một mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
