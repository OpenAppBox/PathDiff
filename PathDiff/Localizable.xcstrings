    "Previous contents kept so changes can be reverted. The oldest backups are removed beyond 2 GB." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحتويات السابقة المحفوظة لإتاحة إرجاع التغييرات. تُزال أقدم النسخ الاحتياطية عند تجاوز 2 غيغابايت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidligere indhold opbevares, så ændringer kan tilbageføres. Over 2 GB fjernes de ældste sikkerhedskopier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frühere Inhalte, die aufbewahrt werden, damit Änderungen zurückgesetzt werden können. Über 2 GB werden die ältesten Backups entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido anterior se guarda para poder revertir los cambios. A partir de 2 GB, se eliminan las copias de seguridad más antiguas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiempi sisältö säilytetään, jotta muutokset voidaan palauttaa. Kun 2 Gt ylittyy, vanhimmat varmuuskopiot poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenus antérieurs conservés pour pouvoir restaurer les modifications. Au-delà de 2 Go, les sauvegardes les plus anciennes sont supprimées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली सामग्री रखी जाती है, ताकि परिवर्तनों को वापस लौटाया जा सके। 2 GB से अधिक होने पर सबसे पुराने बैकअप हटा दिए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi sebelumnya disimpan agar perubahan dapat dikembalikan. Cadangan terlama dihapus jika melebihi 2 GB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenuti precedenti conservati per poter ripristinare le modifiche. Oltre i 2 GB, i backup meno recenti vengono rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更を戻せるように以前の内容を保持します。2 GBを超えると、古いバックアップから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항을 복귀할 수 있도록 이전 내용을 보관합니다. 2GB를 초과하면 가장 오래된 백업부터 제거됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidligere innhold som beholdes slik at endringer kan tilbakestilles. Over 2 GB fjernes de eldste sikkerhetskopiene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerdere inhoud die wordt bewaard zodat wijzigingen kunnen worden teruggezet. Boven 2 GB worden de oudste reservekopieën verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprzednia zawartość przechowywana, aby można było wycofać zmiany. Po przekroczeniu 2 GB najstarsze kopie zapasowe są usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo anterior é mantido para que as alterações possam ser revertidas. Acima de 2 GB, os backups mais antigos são removidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежнее содержимое хранится, чтобы изменения можно было откатить. Когда объем превышает 2 ГБ, самые старые резервные копии удаляются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidigare innehåll som sparas så att ändringar kan återställas. När 2 GB överskrids tas de äldsta säkerhetskopiorna bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื้อหาก่อนหน้าที่เก็บไว้เพื่อให้ย้อนกลับการเปลี่ยนแปลงได้ ข้อมูลสำรองที่เก่าที่สุดจะถูกลบเมื่อเกิน 2 GB"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişikliklerin geri döndürülebilmesi için önceki içerik saklanır. 2 GB aşıldığında en eski yedekler silinir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung trước đó được giữ lại để có thể hoàn nguyên các thay đổi. Các bản sao lưu cũ nhất sẽ bị xóa khi vượt quá 2 GB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留先前的内容，以便复原更改。超过 2 GB 时会移除最旧的备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留先前的內容，以便回復變更。超過 2 GB 時會移除最舊的備份。"
          }
        }
      }
    },
