            "value" : "PathDiff là một phần của OpenAppBox. Ứng dụng mã nguồn mở cho mọi người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PathDiff 是 OpenAppBox 的一员。为每个人打造的开源 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PathDiff 是 OpenAppBox 的一部分。人人可用的開源 App。"
          }
        }
      }
    },
    "PathDiff needs to restart to change its language." : {
