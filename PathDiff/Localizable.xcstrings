    "This is a dry run: review every change below. Nothing is written until you click Sync." : {
      "comment" : "Sync sheet explanation. This is a preview of planned operations, not a trial execution. Sync is the label of the confirmation button.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع التغييرات المخطط لها أدناه. لن تتغير أي ملفات حتى تنقر على «مزامنة»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå de planlagte ændringer nedenfor. Ingen filer ændres, før du klikker på Synkroniser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die geplanten Änderungen unten. Dateien werden erst geändert, wenn du auf „Synchronisieren“ klickst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the planned changes below. No files will change until you click Sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los cambios previstos a continuación. No se modificará ningún archivo hasta que hagas clic en Sincronizar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista suunnitellut muutokset alta. Tiedostoja muutetaan vasta, kun osoitat Synkronoi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les modifications prévues ci-dessous. Aucun fichier ne sera modifié avant que vous cliquiez sur Synchroniser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे दिए गए प्रस्तावित परिवर्तनों की समीक्षा करें। “सिंक करें” पर क्लिक करने तक कोई फ़ाइल नहीं बदलेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau perubahan yang direncanakan di bawah. File tidak akan diubah sampai Anda mengklik Sinkronkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esamina le modifiche previste qui sotto. Nessun file verrà modificato finché non fai clic su Sincronizza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の変更予定を確認してください。「同期」をクリックするまで、ファイルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에서 예정된 변경 사항을 검토하십시오. ‘동기화’를 클릭하기 전까지 파일은 변경되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gjennom de planlagte endringene nedenfor. Ingen filer endres før du klikker på «Synkroniser»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer de geplande wijzigingen hieronder. Bestanden worden pas gewijzigd als je op ‘Synchroniseer’ klikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź planowane zmiany poniżej. Żadne pliki nie zostaną zmienione, dopóki nie klikniesz „Synchronizuj”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise as alterações planejadas abaixo. Nenhum arquivo será alterado até você clicar em Sincronizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте запланированные изменения ниже. Файлы не изменятся, пока вы не нажмете «Синхронизировать»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska de planerade ändringarna nedan. Inga filer ändras förrän du klickar på Synkronisera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจทานการเปลี่ยนแปลงที่วางแผนไว้ด้านล่าง ไฟล์จะยังไม่เปลี่ยนแปลงจนกว่าคุณจะคลิก “เชื่อมข้อมูล”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağıda planlanan değişiklikleri inceleyin. “Eşzamanla” düğmesine tıklayana kadar dosyalarda değişiklik yapılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại các thay đổi dự kiến bên dưới. Không có tệp nào thay đổi cho đến khi bạn bấm Đồng bộ hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
