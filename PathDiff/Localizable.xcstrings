    "A file and a folder share the same name, so the item can’t be copied automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشترك ملف ومجلد في الاسم نفسه، لذا يتعذّر نسخ العنصر تلقائيًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fil og en mappe har samme navn, så emnet kan ikke kopieres automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei und ein Ordner haben denselben Namen, daher kann das Objekt nicht automatisch kopiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo y una carpeta tienen el mismo nombre, por lo que el ítem no se puede copiar automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostolla ja kansiolla on sama nimi, joten kohdetta ei voi kopioida automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier et un dossier portent le même nom : l’élément ne peut donc pas être copié automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक फ़ाइल और एक फ़ोल्डर का नाम समान है, इसलिए आइटम को अपने-आप कॉपी नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File dan folder memiliki nama yang sama, sehingga item tidak dapat disalin secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file e una cartella hanno lo stesso nome, quindi l’elemento non può essere copiato automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルとフォルダが同じ名前のため、この項目は自動ではコピーできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일과 폴더의 이름이 같으므로 이 항목을 자동으로 복사할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fil og en mappe har samme navn, så objektet kan ikke kopieres automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bestand en een map hebben dezelfde naam, dus het onderdeel kan niet automatisch worden gekopieerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik i folder mają tę samą nazwę, więc tej rzeczy nie można skopiować automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo e uma pasta têm o mesmo nome, então o item não pode ser copiado automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл и папка имеют одинаковое имя, поэтому объект нельзя скопировать автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fil och en mapp har samma namn, så objektet kan inte kopieras automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์และโฟลเดอร์ใช้ชื่อเดียวกัน จึงไม่สามารถคัดลอกรายการนี้โดยอัตโนมัติได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dosya ile bir klasör aynı adı taşıdığından öğe otomatik olarak kopyalanamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tệp và một thư mục có cùng tên nên không thể tự động sao chép mục này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件与文件夹同名，因此无法自动拷贝此项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案與檔案夾同名，因此無法自動拷貝此項目。"
          }
        }
      }
    },
