            "value" : "O mesmo arquivo (ou um ligeiramente editado) existe em outro caminho. Pastas inteiras renomeadas aparecem como uma única entrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот же файл (или слегка отредактированный) находится по другому пути. Целиком переименованные папки показываются одной записью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
