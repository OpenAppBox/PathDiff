    "Lines that differ only in spaces and tabs count as equal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعدّ الأسطر التي لا تختلف إلا في المسافات وعلامات الجدولة متطابقة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjer, der kun adskiller sig ved mellemrum og tabulatorer, regnes som ens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen, die sich nur durch Leerzeichen und Tabulatoren unterscheiden, gelten als gleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas que solo se diferencian en espacios y tabulaciones se consideran iguales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivit, jotka eroavat vain välilyöntien ja sarkainten osalta, katsotaan samoiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes qui ne diffèrent que par des espaces et des tabulations sont considérées comme identiques."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो पंक्तियाँ केवल स्पेस और टैब में भिन्न हैं, उन्हें समान माना जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris yang hanya berbeda dalam spasi dan tab dianggap sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le righe che differiscono solo per spazi e tabulazioni sono considerate uguali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペースとタブだけが異なる行は同一とみなされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공백과 탭만 다른 줄은 같은 것으로 간주합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjer som bare er forskjellige i mellomrom og tabulatorer, regnes som like."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regels die alleen verschillen in spaties en tabs, gelden als gelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiersze różniące się tylko spacjami i tabulatorami są uznawane za takie same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linhas que diferem apenas em espaços e tabulações são consideradas iguais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строки, которые различаются только пробелами и табуляциями, считаются одинаковыми."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rader som bara skiljer sig åt i mellanslag och tabbar räknas som lika."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บรรทัดที่ต่างกันเพียงช่องว่างและแท็บจะถือว่าเหมือนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
