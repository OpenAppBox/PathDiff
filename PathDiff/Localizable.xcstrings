    "Changed on both sides at about the same time: sync it one way or copy it from the diff" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر على الجانبين في الوقت نفسه تقريبًا: زامنه في اتجاه واحد أو انسخه من عرض الفروق"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændret på begge sider på omtrent samme tid: Synkroniser den én vej, eller kopier den fra diffen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf beiden Seiten etwa gleichzeitig geändert: in eine Richtung synchronisieren oder aus dem Diff kopieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha cambiado en ambos lados casi a la vez: sincronízalo en un sentido o cópialo desde la vista de diferencias"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuttunut molemmilla puolilla suunnilleen samaan aikaan: synkronoi se yhteen suuntaan tai kopioi se diffistä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifié des deux côtés à peu près au même moment : synchronisez-le dans un sens ou copiez-le depuis le diff"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगभग एक ही समय पर दोनों ओर बदला गया: इसे एक दिशा में सिंक करें या अंतर से कॉपी करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diubah di kedua sisi pada waktu yang hampir bersamaan: sinkronkan ke satu arah atau salin dari diff"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificato su entrambi i lati più o meno nello stesso momento: sincronizzalo in una direzione o copialo dal diff"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両側でほぼ同時に変更されています：どちらか一方向に同期するか、差分からコピーしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양쪽에서 거의 동시에 변경됨: 한 방향으로 동기화하거나 차이점 보기에서 복사하십시오"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endret på begge sider omtrent samtidig: synkroniser én vei eller kopier fra diffen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan beide kanten rond hetzelfde moment gewijzigd: synchroniseer in één richting of kopieer vanuit de diff"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniono po obu stronach mniej więcej w tym samym czasie: zsynchronizuj w jedną stronę lub skopiuj z widoku różnic"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterado nos dois lados quase ao mesmo tempo: sincronize em uma direção ou copie a partir das diferenças"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменено на обеих сторонах примерно в одно время: синхронизируйте в одну сторону или скопируйте из сравнения"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändrad på båda sidor vid ungefär samma tid: synkronisera åt ett håll eller kopiera från diffen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีการเปลี่ยนแปลงทั้งสองฝั่งในเวลาใกล้เคียงกัน: เชื่อมข้อมูลไปทางเดียวหรือคัดลอกจากมุมมองความแตกต่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki tarafta da yaklaşık aynı anda değişti: tek yönde eşzamanlayın ya da fark görünümünden kopyalayın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã thay đổi ở cả hai bên vào khoảng cùng thời điểm: hãy đồng bộ hóa một chiều hoặc sao chép từ chế độ xem khác biệt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两侧几乎同时被更改：请单向同步，或从差异视图中拷贝"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩側幾乎同時修改：請單向同步，或從差異中拷貝"
          }
        }
      }
    },
